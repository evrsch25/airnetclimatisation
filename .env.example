# Adresse publique du site, sans slash final.
# Sert aux URL canoniques, au sitemap et aux images de partage.
# Local        : http://localhost:3000
# Préproduction: https://airnetclimatisation.vercel.app
# Production   : https://www.airnetclimatisation.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulaire de contact (Resend) — voir docs/RESEND.md
RESEND_API_KEY=
CONTACT_EMAIL=contact@airnetclimatisation.fr
# Expéditeur : nécessite un domaine vérifié dans Resend.
# Tant que le domaine n'est pas vérifié, laisser vide (bascule sur onboarding@resend.dev).
RESEND_FROM="Air Net Climatisation <contact@airnetclimatisation.fr>"
